{
  "name": "@offerpath/database",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "pnpm generate && tsup",
    "generate": "prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "validate": "prisma validate",
    "typecheck": "pnpm generate && tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "import:job-hunter": "dotenv -e ../../.env -- tsx src/import/job-hunter.ts",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "import:forge-routine": "dotenv -e ../../.env -- tsx src/import/forge-routine.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "dotenv-cli": "^8.0.0",
    "mongodb": "^7.7.0",
    "prisma": "^6.2.1",
    "tsup": "^8.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "@offerpath/curriculum": "workspace:*"
  }
}
