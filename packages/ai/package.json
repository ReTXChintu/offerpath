{
  "name": "@offerpath/ai",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@offerpath/config": "workspace:*",
    "@offerpath/types": "workspace:*",
    "@offerpath/shared": "workspace:*",
    "@offerpath/validation": "workspace:*",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1",
    "openai": "^4.77.3"
  }
}
