# Offerpath: the one .env for the whole repo. Copy to .env and fill in.
# Read and validated by packages/config (src/env.ts). Never commit .env.

NODE_ENV=development
LOG_LEVEL=info
# The zone every "today" is measured in (IANA name).
APP_TIMEZONE=Asia/Kolkata

# --- Server -----------------------------------------------------------------
# No nginx: Traefik owns 80/443 on the server, so both are reached by ip:port.
# The API: REST (/api/v1), the hub WebSocket, downloads and updates.
OFFERPATH_API_PORT=50005
# The built web app, served as static files by PM2 (offerpath-web).
OFFERPATH_WEB_PORT=50004
OFFERPATH_HOST=0.0.0.0
# Browser origins allowed to call the API, comma-separated: the web app's address.
OFFERPATH_CORS_ORIGINS=http://localhost:50004
# The web app's API address, fixed at build time. Leave empty: in development the
# Vite proxy forwards /api, and in production the web app calls this host on 50005.
VITE_OFFERPATH_API_URL=
# open | closed: close sign-up without a release.
OFFERPATH_SIGNUP=open

# --- Database: PostgreSQL on Neon (free tier) --------------------------------
# Pooled connection (host with -pooler) for the app.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/offerpath?sslmode=require
# Direct connection (host without -pooler) for `prisma migrate deploy`.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/offerpath?sslmode=require
# The API's e2e suites only: a separate database (they refuse DATABASE_URL).
TEST_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/offerpath_test?sslmode=require

# --- Redis: the server's existing instance, shared, so always prefixed --------
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=offerpath:
REDIS_ENABLED=false

# --- Sessions -----------------------------------------------------------------
# Two different random values, at least 32 characters each:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- AI: Claude Code on each user's desktop; the server holds no key ----------
# How long the desktop gets for one AI job.
AI_REQUEST_TIMEOUT_MS=180000
# Tokens per user per day for learning AI before falling back; 0 = no limit.
AI_DAILY_TOKEN_BUDGET=0
# Encrypts the OpenAI fallback keys users save for interview prep (used only
# when their desktop is offline). Without it the fallback can't be saved.
#   openssl rand -base64 32
ENCRYPTION_KEY=
# OpenAI models the fallback uses when a user hasn't picked their own.
OPENAI_FALLBACK_MODEL_FAST=gpt-4.1-mini
OPENAI_FALLBACK_MODEL_REASONING=gpt-4.1

# --- Devices and app builds ----------------------------------------------------
PAIRING_CODE_TTL_SECS=300
# Firebase service account (JSON, base64 of it, or a path) for push to phones.
# FCM_SERVICE_ACCOUNT=secrets/offerpath-firebase-adminsdk.json
DOWNLOADS_DIR=apps/api/downloads

# --- Code execution (sandbox) ----------------------------------------------------
# inline: the API runs code itself; queue: apps/sandbox does, through Redis.
EXECUTION_DRIVER=inline
EXECUTION_TIMEOUT_MS=5000
EXECUTION_MAX_MEMORY_MB=128
EXECUTION_CONCURRENCY=2

# --- Client builds (read at compile time by the web, desktop and mobile builds) --
# OFFERPATH_SERVER_URL=http://<server-ip>:50005
