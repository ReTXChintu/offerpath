{
  "name": "offerpath",
  "private": true,
  "version": "0.1.0",
  "description": "Offerpath - finds the jobs, gets you ready for the interviews, and moves you one step closer to the offer every day.",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@offerpath/api --filter=@offerpath/web",
    "dev:desktop": "pnpm --filter @offerpath/desktop tauri dev",
    "tauri": "pnpm --filter @offerpath/desktop tauri",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:rust": "cargo test --workspace",
    "check:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "fmt:rust": "cargo fmt --all",
    "check": "bash scripts/check-all.sh",
    "db:generate": "pnpm --filter @offerpath/database generate",
    "db:migrate": "pnpm --filter @offerpath/database migrate",
    "db:deploy": "pnpm --filter @offerpath/database migrate:deploy",
    "db:studio": "pnpm --filter @offerpath/database studio",
    "server:build": "turbo run build --filter=@offerpath/api... --filter=@offerpath/web... --filter=@offerpath/sandbox...",
    "server:start": "pm2 startOrReload ecosystem.config.cjs --update-env",
    "server:stop": "pm2 stop ecosystem.config.cjs",
    "server:restart": "pm2 restart ecosystem.config.cjs --update-env",
    "server:logs": "pm2 logs offerpath-api --lines 200",
    "server:status": "pm2 status",
    "server:update": "git pull --ff-only && bash scripts/server-update.sh",
    "release": "release-it",
    "release:patch": "release-it patch --ci",
    "release:minor": "release-it minor --ci",
    "release:major": "release-it major --ci",
    "release:dry": "release-it --dry-run --ci",
    "versions:check": "node scripts/sync-versions.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^16.4.0",
    "pm2": "^7.0.4",
    "prettier": "^3.6.0",
    "release-it": "^21.1.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.48.0"
  }
}
